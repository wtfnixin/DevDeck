app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local SDK Settings
/android/local.properties
.flutter-plugins

# Desktop Agent related
/desktop-agent/node_modules/
/desktop-agent/dist/
/desktop-agent/build/
/desktop-agent/bin/*
!/desktop-agent/bin/window-focus.exe
!/desktop-agent/bin/brightness-control.exe
!/desktop-agent/bin/keypresser.exe
!/desktop-agent/bin/desktop-switcher.exe
/desktop-agent/logs/
/desktop-agent/.env
/desktop-agent/devdeck.db
/desktop-agent/devdeck.db-*
/artifacts/pairing-qr.png
*.db-shm
*.db-wal

# Root-level ignore of local database and logs
/devdeck.db
/devdeck.db-*
/artifacts/
/.agents/
# Markdown documentation files (ignore internal docs except community health files)
*.md
!README.md
!README.MD
!readme.md
!CONTRIBUTING.md
!CODE_OF_CONDUCT.md
!SECURITY.md
!.github/**/*.md

# Raw brand assets and extractions
/assets/extracted/
/assets/mockup and logo.png

# Python cache
**/__pycache__/



