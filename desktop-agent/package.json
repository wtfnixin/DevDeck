{
  "name": "devdeck-desktop-agent",
  "version": "1.0.0",
  "description": "Desktop agent for DevDeck personal productivity remote control",
  "author": "wtfnixin",
  "main": "electron-main.js",
  "bin": "dist/index.js",
  "pkg": {
    "assets": [
      "dist/**/*",
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node"
    ]
  },
  "build": {
    "appId": "com.devdeck.desktopagent",
    "productName": "DevDeck Agent",
    "publish": [
      {
        "provider": "github",
        "owner": "wtfnixin",
        "repo": "StreamDeck"
      }
    ],
    "directories": {
      "output": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DevDeck Agent",
      "artifactName": "DevDeckAgentSetup.${ext}"
    },
    "portable": {
      "artifactName": "devdeck-agent.${ext}"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "electron-main.js",
      "package.json",
      "node_modules/**/*"
    ],
    "extraFiles": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "*.exe"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ]
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "gui": "npm run build && npx electron electron-main.js",
    "gui:dev": "npm run build && npx electron electron-main.js",
    "build:exe": "node build-exe.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.1",
    "copy-paste": "^2.2.0",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.5",
    "winston": "^3.12.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/copy-paste": "^2.1.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.24",
    "@types/qrcode": "^1.5.5",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "private": true
}
